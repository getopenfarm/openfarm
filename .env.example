# Copy to .env and adjust as needed before running `docker compose up` in infra/

POSTGRES_USER=openfarm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openfarm
POSTGRES_PORT=5432

API_HTTP_PORT=6868
WEB_PORT=5173

ConnectionStrings__Default=Host=localhost;Port=5432;Database=openfarm;Username=openfarm;Password=changeme
ASPNETCORE_ENVIRONMENT=Development

Jwt__Issuer=OpenFarm
Jwt__Audience=OpenFarm
Jwt__SigningKey=dev-only-signing-key-do-not-use-in-production-0123456789ABCDEF

Seed__AdminUsername=admin
Seed__AdminEmail=admin@openfarm.local
Seed__AdminPassword=admin-openfarm

DataProtection__KeysDirectory=/keys
# Production hardening: without a certificate, DataProtection keys are stored on the keys volume
# unencrypted (no DPAPI-equivalent fallback on Linux) — set these to a PKCS#12 cert to encrypt
# them at rest. Leave blank for local/self-hosted use.
DataProtection__CertificatePath=
DataProtection__CertificatePassword=

Cors__AllowedOrigins__0=http://localhost:5173

PartFileStorage__RootDirectory=/data/part-files

# Bundled slicer directory, populated by `tools/provision-slicers` (dev/build-time only — the
# running app never downloads). Layout: <RootDirectory>/<engineSlug>/<version>/<platformSlug>/...
SlicerBundle__RootDirectory=/data/slicers
Slicing__MaxConcurrentSlicingOperations=2
