# Copy to .env next to docker-compose.yml. Read by both postgres and openfarm.
# Every setting has a default. Uncomment a commented line only to change it.

# Public address when using Cloudflare Tunnel or another reverse proxy.
# HTTPS enables Secure refresh cookies; use this address rather than HTTP LAN login.
# Optional: omit for local HTTP hosting. Restart/recreate openfarm after changing it.
# ORIGIN=https://farm.example.com

# Database. Postgres reads these only when it creates a new volume.
POSTGRES_USER=openfarm
# Recommended: change the password before the first start.
POSTGRES_PASSWORD=openfarm
POSTGRES_DB=openfarm

# First administrator, created on the first start only.
# Recommended: set a password. Without one, the password is the public default "admin-openfarm".
# Seed__AdminPassword=
# Seed__AdminUsername=admin
# Seed__AdminEmail=admin@openfarm.local

# Recommended: encrypt the stored printer secrets. Without a certificate, their keys sit unencrypted in ./data/keys.
# Put a PKCS#12 certificate in ./data and point to it.
# DataProtection__CertificatePath=/data/dataprotection.pfx
# DataProtection__CertificatePassword=

# Login tokens are signed with a key that the first start generates in ./data/keys/jwt-signing-key.
# Optional: set your own, for example to keep logins valid when you rebuild ./data. Generate one with:
#   openssl rand -base64 48
# Jwt__SigningKey=

# Host user and group that own ./data. Run `id -u` and `id -g`.
# PUID=1000
# PGID=1000

# Log timestamps.
# TZ=Etc/UTC

# Optional: another Postgres server instead of the postgres service.
Database__Host=127.0.0.1
# Database__Port=5432

# Optional: slicing jobs that run at the same time (CPU heavy).
# Slicing__MaxConcurrentSlicingOperations=2

# MCP is disabled by default. Normally configure it under Settings > AI assistants.
# Optional mode override (locks the matching UI field). ORIGIN above locks the public URL:
# MCP_MODE=SignIn
# Optional availability override. Unset leaves control in Settings.
# MCP_ENABLED=true
# Explicit false disables every MCP mode:
# MCP_ENABLED=false
# OAUTH_ENABLED is a legacy one-time upgrade import; use MCP_MODE for deployment control.

# Optional OIDC login (authentik). Use the exact issuer URL, including its trailing slash.
# Requires an HTTPS public URL (ORIGIN or the saved server URL); HTTP only on localhost.
# Register https://farm.example.com/api/v1/auth/sso/callback as an exact redirect URI.
# Auth__Oidc__Enabled=true
# Auth__Oidc__DisplayName=authentik
# Auth__Oidc__Authority=https://auth.example.com/application/o/openfarm/
# Auth__Oidc__ClientId=
# Auth__Oidc__ClientSecret=
# Auth__Oidc__SessionHours=8
# First link existing accounts under My profile > Security in optional mode.
# To require OIDC, designate and test a local recovery administrator by immutable user ID.
# Auth__Oidc__Required=true
# Auth__Oidc__RecoveryUserIds__0=00000000-0000-0000-0000-000000000000
# OIDC sign-out is local. Disable the OpenFarm account for immediate upstream deprovisioning.

# Optional first-login provisioning. The default group must exist and cannot be protected.
# Auth__Oidc__Jit__Enabled=true
# Auth__Oidc__Jit__RequireVerifiedEmail=true
# Auth__Provisioning__DefaultGroup=Viewers

# Optional SCIM 2.0 backchannel for authentik: https://farm.example.com/scim/v2
# SCIM externalId MUST equal OIDC sub. Use authentik's Hashed User ID / user.uid consistently.
# Generate a separate credential with: openssl rand -hex 32
# Auth__Scim__Enabled=true
# Auth__Scim__BearerToken=
# Auth__Scim__RequestsPerMinute=300
# Auth__Scim__GroupMappings__openfarm-viewers=Viewers
# Auth__Scim__GroupMappings__openfarm-operators=Operators
# JIT and SCIM create passwordless accounts. Existing local accounts are not automatically adopted.
# SCIM deactivation revokes browser sessions, connected apps and personal tokens atomically.
