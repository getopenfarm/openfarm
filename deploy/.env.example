# Copy to .env next to docker-compose.yml. Read by both postgres and openfarm.
# Every setting has a default. Uncomment a commented line only to change it.

# Database. Postgres reads these only when it creates a new volume.
POSTGRES_USER=openfarm
# Recommended: change the password before the first start.
POSTGRES_PASSWORD=openfarm
POSTGRES_DB=openfarm

# First administrator, created on the first start only.
# Recommended: set a password. Without one, a random password is logged once, and the log is gone when the
# container is recreated (for example on upgrade), so save it right away:
#   docker compose logs openfarm | grep "generated password"
# Seed__AdminPassword=
# Seed__AdminUsername=admin
# Seed__AdminEmail=admin@openfarm.local

# Recommended: encrypt the stored printer secrets. Without a certificate, their keys sit unencrypted in ./data/keys.
# Put a PKCS#12 certificate in ./data and point to it.
# DataProtection__CertificatePath=/data/dataprotection.pfx
# DataProtection__CertificatePassword=

# Login tokens are signed with a key that the first start generates in ./data/keys/jwt-signing-key.
# Optional: set your own, for example to keep logins valid when you rebuild ./data. Generate one with:
#   openssl rand -base64 48
# Jwt__SigningKey=

# Host user and group that own ./data. Run `id -u` and `id -g`.
# PUID=1000
# PGID=1000

# Log timestamps.
# TZ=Etc/UTC

# Optional: another Postgres server instead of the postgres service.
# Database__Host=postgres
# Database__Port=5432

# Optional: slicing jobs that run at the same time (CPU heavy).
# Slicing__MaxConcurrentSlicingOperations=2
