<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenFarm.Application\OpenFarm.Application.csproj" />
    <ProjectReference Include="..\OpenFarm.Domain\OpenFarm.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bambu's own per-device TLS cert bundle (vendored from pybambu/certs/), used to pin
         BambuLanConnector's TLS trust store per research.md §1 instead of the system CA store. -->
    <EmbeddedResource Include="Printers\Bambu\Certs\*.cert" />
    <!-- Vendored printer error text and model-specific links; no runtime network lookup. -->
    <EmbeddedResource Include="Printers/Bambu/AlertData/hms_en.json.gz" LogicalName="OpenFarm.BambuAlerts.hms_en.json.gz" />
    <EmbeddedResource Include="Printers/Bambu/AlertData/wiki_links.json.gz" LogicalName="OpenFarm.BambuAlerts.wiki_links.json.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <!-- BambuLanConnector.StartJobAsync's FTPS file push (port 990, research.md R5) — .NET has no
         built-in FTPS client. -->
    <PackageReference Include="FluentFTP" Version="54.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Finbuckle.MultiTenant" Version="10.1.1" />
    <PackageReference Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="10.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
    <!-- Pins the transitive dependency Microsoft.EntityFrameworkCore.Design 10.0.9 pulls in past its
         own known high-severity vulnerabilities (GHSA-23rf-6693-g89p and siblings) — same "explicit
         override" fix pattern already used for web/'s bun audit CVEs. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Infrastructure.Tests fixture-test internal, pure/deterministic logic (e.g.
         BambuCertificateTrust) directly, same rationale as BambuCameraFrameCodec's extraction. -->
    <InternalsVisibleTo Include="OpenFarm.Infrastructure.Tests" />
  </ItemGroup>

</Project>
