---
import Icon from '../components/Icon.astro';
import LiveDemo from '../components/LiveDemo.astro';
import Site from '../layouts/Site.astro';

const github = 'https://github.com/getopenfarm/openfarm';
const raw = 'https://raw.githubusercontent.com/getopenfarm/openfarm/main/deploy';
const commands = [
  { line: 'mkdir openfarm && cd openfarm' },
  { line: `base=${raw}` },
  { line: 'curl -fsSLo docker-compose.yml $base/docker-compose.prod.yml' },
  { line: 'curl -fsSLo .env $base/.env.example' },
  { comment: '# Set passwords in .env. Publish Postgres on 127.0.0.1:5432 (see the guide).' },
  { line: 'docker compose up -d' },
];
const features = [
  { icon: 'layout-dashboard', title: 'Every printer on one screen', body: 'Current plate, temperatures, progress, and the filament in each slot. Live over LAN.', show: '/', wide: true },
  { icon: 'clipboard-list', title: 'A queue that explains itself', body: 'Each waiting plate lists the printers that match. Every other printer shows the check that failed.', tour: 'why-waiting', wide: true },
  { icon: 'list-checks', title: 'Runs for real orders', body: 'Order products or sets. Each run tracks finished units, failed plates and requeues.', show: '/production-runs' },
  { icon: 'layers', title: 'Filament to the gram', body: 'Stock by color, days left and value. Spools follow their AMS slot.', tour: 'filament' },
  { icon: 'package', title: 'Costs before you quote', body: 'Material, machine time and fees for each assembly, with a sale price.', show: '/assemblies/a55e0000-0000-4000-8000-000000000001' },
  { icon: 'chart-column', title: 'Stats from real activity', body: 'Success rate, utilization and waste, per printer and per day.', tour: 'stats' },
] as const;
const faqs = [
  { q: 'Which printers can I connect?', a: 'Bambu Lab X1, X1 Carbon, X1E, P1P, P1S, A1 and A1 mini, in LAN mode. Snapmaker U1, through Moonraker. OpenFarm supports a model only after the model is in the catalog.', href: '/docs/printers/supported-printers/', label: 'Supported printers' },
  { q: 'Where does OpenFarm run?', a: 'One OpenFarm instance with PostgreSQL, on a Linux/amd64 server with LAN access to the printers. The team uses OpenFarm in a browser.', href: '/docs/installation/docker/', label: 'Installation requirements' },
  { q: 'Does OpenFarm clear the bed?', a: 'No. Inspect the print. Clear the bed. Mark the printer ready. The next matching plate then starts.', href: '/docs/', label: 'Quick start' },
  { q: 'Can I print fixed batches and repeat stock?', a: 'Yes. A run makes a fixed quantity of parts or complete sets. Continuous backfill prints repeat stock on idle, compatible printers after the fixed work.', href: '/docs/production/backfill/', label: 'Continuous backfill' },
  { q: 'Is OpenFarm free?', a: 'Yes. OpenFarm is open source under AGPL-3.0, with no fee per printer or seat. Read the license before you modify or distribute OpenFarm.', href: `${github}/blob/main/LICENSE`, label: 'AGPL-3.0 license' },
];
const spoolColors = ['#1a1a1a', '#f2f2f2', '#e53935', '#fb8c00', '#fdd835', '#43a047', '#2ea6a6', '#1e88e5', '#0a2989', '#8e24aa', '#e8afcf', '#9b9ea0', '#ff6a13', '#3b6e3b', '#f2c230', '#c12e1f'];
const spools = Array.from({ length: 96 }, (_, index) => spoolColors[(index * 7 + Math.floor(index / 16) * 3) % spoolColors.length]);
---

<Site>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title"><span class="print"><span class="print-layers">Self-hosted 3D print farm management</span><span class="print-nozzle" aria-hidden="true"></span></span></h1>
    <p class="hero-lede">Queue production runs. Send each plate to a matching printer. Track every spool to the gram. Open source, on your own hardware.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/docs/installation/docker/">Install with Docker</a>
      <a class="button" href="#demo">Try the live demo</a>
    </div>
    <p class="hero-note">Connects over LAN: Bambu Lab X1, P1 and A1 series, Snapmaker U1.</p>
  </section>

  <LiveDemo />

  <section class="section container" aria-labelledby="flow-title">
    <div class="section-head">
      <h2 id="flow-title">From an order to the next plate</h2>
      <p>Plans the plates. Picks a printer for each plate. Starts the next print when you clear the bed.</p>
    </div>
    <ol class="flow">
      <li>
        <span class="flow-number" aria-hidden="true">1</span>
        <h3>You plan a run</h3>
        <p>Order finished products or part quantities. Assemblies expand into their parts.</p>
        <div class="flow-artifact">
          <p class="artifact-title">Electronics enclosure ×8</p>
          <p class="artifact-meta">8 bases, 8 lids, 16 knobs</p>
        </div>
      </li>
      <li>
        <span class="flow-number" aria-hidden="true">2</span>
        <h3>OpenFarm plans the plates</h3>
        <p>Units per plate set the plate count. Each plate becomes one queued job.</p>
        <div class="flow-artifact">
          <p class="artifact-title">6 plates</p>
          <div class="plates" aria-hidden="true"><span class="done"></span><span class="printing"></span><span class="printing"></span><span></span><span></span><span></span></div>
          <p class="artifact-meta">1 done, 2 printing, 3 waiting</p>
        </div>
      </li>
      <li>
        <span class="flow-number" aria-hidden="true">3</span>
        <h3>OpenFarm picks the printer</h3>
        <p>Checks nozzle, loaded filament and readiness before it sends a plate.</p>
        <div class="flow-artifact">
          <ul class="checks">
            <li><span><strong>P1S-02</strong> PLA Matte Charcoal loaded</span></li>
            <li class="no"><span><strong>X1C-01</strong> 0.6 mm nozzle, needs 0.4 mm</span></li>
            <li class="no"><span><strong>A1M-01</strong> PETG loaded, needs PLA</span></li>
          </ul>
        </div>
      </li>
      <li>
        <span class="flow-number" aria-hidden="true">4</span>
        <h3>You clear the bed</h3>
        <p>Mark the printer ready after your check. The next matching plate starts.</p>
        <div class="flow-artifact">
          <div class="handoff"><span class="chip chip-attention">Awaiting clear</span><span class="arrow" aria-hidden="true">→</span><span class="chip chip-ok">Printing</span></div>
          <p class="artifact-meta">Control knob, plate 1 of 2</p>
        </div>
      </li>
    </ol>
  </section>

  <section id="features" class="section container" aria-labelledby="features-title">
    <div class="section-head">
      <h2 id="features-title">Everything the farm runs on</h2>
      <p>Printers, queue, runs, filament, costs and stats in one workspace. Each card opens its page in the live demo.</p>
    </div>
    <div class="features">
      {features.map((feature) => (
        <article class:list={['feature', { 'feature-wide': 'wide' in feature }]}>
          <span class="feature-icon"><Icon name={feature.icon} size={20} /></span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
          {feature.show === '/' && (
            <div class="feature-detail" aria-hidden="true"><span class="chip chip-ok">5 printing</span><span class="chip chip-attention">1 awaiting</span><span class="chip chip-idle">2 idle</span></div>
          )}
          {'tour' in feature && feature.tour === 'why-waiting' && (
            <div class="feature-detail" aria-hidden="true"><span class="waiting">Waiting for printer</span><span class="reason">X1C-01: Nozzle diameter: requires 0.4 mm, actual 0.6 mm.</span></div>
          )}
          <button type="button" class="show" data-tour={'tour' in feature ? feature.tour : undefined} data-show={'show' in feature ? feature.show : undefined}>Show in demo</button>
        </article>
      ))}
    </div>
    <p class="section-more">Also included: maintenance by print hours, days or prints. Part and assembly libraries. Slicer profiles. Team permissions. A REST API with scoped tokens. <a href="/docs/">Browse the guides</a></p>
  </section>

  <section class="section container price" aria-labelledby="price-title">
    <h2 id="price-title" class="price-figure">$0<span>per printer</span></h2>
    <p>Free and open source under AGPL-3.0. No vendor account. No fee per seat. Printers connect directly over LAN.</p>
    <a class="text-link" href={github}>View the source on GitHub</a>
  </section>

  <section id="install" class="section container" aria-labelledby="install-title">
    <div class="section-head">
      <h2 id="install-title">Run OpenFarm on your server</h2>
      <p>One Docker Compose stack: OpenFarm and PostgreSQL, on a Linux host with LAN access to the printers.</p>
    </div>
    <div class="install">
      <div>
        <ol class="steps">
          <li><div><strong>Get the Compose files</strong><span>docker-compose.yml and .env from the repository.</span></div></li>
          <li><div><strong>Set passwords</strong><span>Database and first administrator, in .env. Publish Postgres on 127.0.0.1, as in the guide.</span></div></li>
          <li><div><strong>Start the farm</strong><span>Open http://&lt;server-ip&gt;:6868. Add the first printer.</span></div></li>
        </ol>
        <dl class="requirements">
          <div><dt>Host</dt><dd>Linux, amd64, Docker Compose</dd></div>
          <div><dt>Network</dt><dd>LAN access to the printers</dd></div>
          <div><dt>Bambu Lab</dt><dd>X1, X1 Carbon, X1E, P1P, P1S, A1, A1 mini</dd></div>
          <div><dt>Snapmaker</dt><dd>U1, through Moonraker</dd></div>
        </dl>
        <p class="install-guide"><a class="text-link" href="/docs/installation/docker/">Read the installation guide</a></p>
      </div>
      <figure class="code">
        <div class="code-bar"><span>Terminal</span><button type="button" class="code-copy" data-copy><Icon name="copy" size={13} /><span>Copy</span></button></div>
        <pre><code>{commands.map((item) => ('line' in item ? <span data-line={item.line}><span class="prompt">$ </span>{item.line}{'\n'}</span> : <span class="comment" data-line={item.comment}>{item.comment}{'\n'}</span>))}</code></pre>
      </figure>
    </div>
  </section>

  <section id="faq" class="section container faq" aria-labelledby="faq-title">
    <div class="section-head"><h2 id="faq-title">Before you install</h2></div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <div><p>{faq.a}</p><a class="text-link" href={faq.href}>{faq.label}</a></div>
        </details>
      ))}
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <div class="spools" aria-hidden="true">{spools.map((color) => <i style={`--c:${color}`}></i>)}</div>
    <div class="container">
      <h2 id="cta-title">Put the whole farm on one screen</h2>
      <p>Install OpenFarm. Connect a printer. Send the first part from the library to the queue.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/docs/installation/docker/">Install with Docker</a>
        <a class="button" href="/docs/">Read the docs</a>
      </div>
    </div>
  </section>
</Site>

<script>
  import { mountCopyButtons } from '../scripts/live-demo';
  mountCopyButtons();
</script>
