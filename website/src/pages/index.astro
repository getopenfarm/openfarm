---
import Site from '../layouts/Site.astro';

const features = [
  { number: '01', title: 'See the whole fleet', description: 'Follow printer status and current work. Keep maintenance alongside the machines that need it.', href: '/docs/printers/manage-fleet/', label: 'Manage printers' },
  { number: '02', title: 'Know what is loaded', description: 'Track filament, physical spools, remaining material, and feed slots in one place.', href: '/docs/filament/spools/', label: 'Track filament' },
  { number: '03', title: 'Build a reusable library', description: 'Organize parts, sliced files, profiles, and assemblies so the next batch starts with the right requirements.', href: '/docs/library/parts/', label: 'Explore the library' },
  { number: '04', title: 'Give every job a path', description: 'Queue individual plates, plan production runs, and use continuous backfill to fill spare capacity.', href: '/docs/production/runs/', label: 'Plan production' },
  { number: '05', title: 'Understand what is waiting', description: 'See why a printer cannot take a job and follow the diagnosis to the configuration that needs attention.', href: '/docs/production/matching/', label: 'Understand matching' },
  { number: '06', title: 'Keep track of the outcome', description: 'Review production results, material usage, and cost estimates as your farm keeps working.', href: '/docs/operations/stats/', label: 'Review farm statistics' },
];
---

<Site>
  <section class="container hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow"><span class="brand-dot" aria-hidden="true"></span> Open source. Self-hosted.</p>
      <h1 id="hero-title">Your print farm.<br /><span>One clear workspace.</span></h1>
      <p class="hero-description">Bring your printers, filament, parts, and production together. Run OpenFarm on your own server and keep your farm moving.</p>
      <div class="actions">
        <a class="button primary" href="/docs/installation/docker/">Set up OpenFarm <span aria-hidden="true">→</span></a>
        <a class="button" href="/docs/">Read the docs</a>
      </div>
      <p class="hero-note">Connect directly to supported printers on your local network.</p>
    </div>
    <aside class="workflow" aria-labelledby="workflow-title">
      <div class="panel-heading"><img src="/openfarm.svg" alt="" width="22" height="22" /><h2 id="workflow-title">From file to finished part</h2></div>
      <ol class="workflow-steps">
        <li><span class="step-number">01</span><div><h3>Prepare the work</h3><p>Add parts, choose profiles, and track the filament ready for production.</p></div></li>
        <li><span class="step-number">02</span><div><h3>Find the right printer</h3><p>Match queued work to compatible printers and loaded material.</p></div></li>
        <li><span class="step-number">03</span><div><h3>Keep the cycle moving</h3><p>Inspect the output, clear the bed, and mark the printer ready for its next job.</p></div></li>
      </ol>
      <a class="panel-footer" href="/docs/">Follow the quick start <span aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section class="compatibility" aria-label="Printer compatibility">
    <div class="container compatibility-inner"><p>Built for a connected farm</p><div><span>Bambu Lab</span><span>Snapmaker U1</span><a href="/docs/printers/supported-printers/">Check supported models <span aria-hidden="true">→</span></a></div></div>
  </section>

  <section id="features" class="container features" aria-labelledby="features-title">
    <div class="section-heading"><p class="eyebrow">Operate. Organize. Repeat.</p><h2 id="features-title">Less switching.<br />More making.</h2><p>One place for the daily work and the records behind it.</p></div>
    <div class="feature-grid">
      {features.map((feature) => (
        <article class="feature">
          <span class="feature-number" aria-hidden="true">{feature.number}</span>
          <h3>{feature.title}</h3><p>{feature.description}</p>
          <a href={feature.href}>{feature.label} <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="container ownership" aria-labelledby="ownership-title">
    <div><p class="eyebrow">At home on your network</p><h2 id="ownership-title">Your server. Your farm.</h2><p>Keep the database and files on your own infrastructure. The OpenFarm server connects to your printers; your team works through the browser.</p></div>
    <div class="ownership-actions"><a class="button primary" href="/docs/installation/docker/">Installation guide <span aria-hidden="true">→</span></a><a class="text-link" href="https://github.com/getopenfarm/openfarm">Explore the source on GitHub <span aria-hidden="true">↗</span></a></div>
  </section>
</Site>
