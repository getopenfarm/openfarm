---
import DemoIcon from './DemoIcon.astro';
import PrinterDrawing from './PrinterDrawing.astro';
import '../styles/product-demo.css';
import { demoViews as views, demoSpools as spools } from '../lib/demo-data';
---

<section id="demo" class="container product-showcase" aria-labelledby="demo-title">
  <div class="showcase-heading"><div><p class="eyebrow">A little less explaining. A little more exploring.</p><h2 id="demo-title">Take a look around your next workspace.</h2></div><span class="demo-sample-label"><span aria-hidden="true"></span> Interactive preview · Sample data</span></div>
  <div class="demo-glow">
    <div class="product-demo" data-product-demo data-view="dashboard" data-printing="false">
      <div class="demo-window-bar"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>OpenFarm / Demo farm</span><div class="demo-window-actions"><button type="button" data-demo-theme-toggle disabled aria-label="Switch preview to dark mode"><DemoIcon name="sun" /><span data-theme-label>Dark mode</span></button><button type="button" data-demo-reset disabled><DemoIcon name="reset" /><span>Reset</span></button></div></div>
      <div class="demo-shell">
        <div class="demo-sidebar">
          <div class="demo-brand"><img src="/openfarm.svg" alt="" width="27" height="27" /><span>OpenFarm</span></div>
          <p class="demo-nav-label">Operate</p>
          <div class="demo-nav" role="tablist" aria-label="Explore the OpenFarm preview" aria-orientation="vertical">
            {views.map((view, index) => (<button type="button" role="tab" id={`demo-tab-${view.id}`} aria-controls={`demo-panel-${view.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-demo-view={view.id} disabled><DemoIcon name={view.id} /><span>{view.label}</span>{view.id === 'queue' && <span class="demo-nav-count" data-queued-count>1</span>}</button>))}
          </div>
          <div class="demo-sidebar-bottom"><span class="demo-avatar">OF</span><div><strong>Demo farm</strong><span>Local workspace</span></div></div>
        </div>
        <div class="demo-workspace">
          <div class="demo-breadcrumb"><span>Demo farm</span><span aria-hidden="true">/</span><span data-current-view>Dashboard</span><span class="demo-sample-badge">Sample data</span></div>
          <section id="demo-panel-dashboard" role="tabpanel" aria-labelledby="demo-tab-dashboard" tabindex="0" data-demo-panel="dashboard">
            <div class="demo-page-heading"><div><h3>Dashboard</h3><p>Your farm, at a glance.</p></div><span class="demo-connection"><span></span> 3 printers online</span></div>
            <dl class="demo-kpis"><div><dt>Printing</dt><dd><span data-printing-count>1</span><small>/ 3 printers</small></dd></div><div><dt>Awaiting clearance</dt><dd data-clearance-count>1</dd></div><div><dt>Queued plates</dt><dd data-queued-count>1</dd></div></dl>
            <div class="demo-printer-grid">
              <article class="demo-printer"><div class="demo-printer-heading"><h4>Workshop P1S</h4><span class="demo-status" data-p1s-status data-status="attention">Awaiting clearance</span></div><div class="demo-printer-art demo-p1s-art"><PrinterDrawing /></div><div class="demo-printer-details"><p>Bambu Lab P1S <span>0.4 mm</span></p><strong data-p1s-job>Ready for its next plate</strong><p>PLA · Black <span>AMS slot 1</span></p></div><button class="demo-button demo-button-primary" type="button" data-demo-ready disabled><span data-ready-label>Mark ready</span><DemoIcon name="arrow" /></button></article>
              <article class="demo-printer"><div class="demo-printer-heading"><h4>Studio A1</h4><span class="demo-status" data-status="printing">Printing</span></div><div class="demo-printer-art"><PrinterDrawing active /></div><div class="demo-printer-details"><p>Bambu Lab A1 <span>0.4 mm</span></p><strong>Enclosure lid · Plate 1</strong><div class="demo-job-progress" role="progressbar" aria-label="Sample A1 print progress" aria-valuenow="64" aria-valuemin="0" aria-valuemax="100"><span style="width:64%"></span></div><p>PLA · Blue <span>64%</span></p></div><button class="demo-button" type="button" data-demo-shortcut="queue" disabled>View queue <DemoIcon name="arrow" /></button></article>
              <article class="demo-printer"><div class="demo-printer-heading"><h4>Bench U1</h4><span class="demo-status" data-status="idle">Idle</span></div><div class="demo-printer-art"><PrinterDrawing /></div><div class="demo-printer-details"><p>Snapmaker U1 <span>0.4 mm</span></p><strong>Available for compatible work</strong><p>PETG · Orange <span>880 g</span></p></div><button class="demo-button" type="button" data-demo-shortcut="filament" disabled>View filament <DemoIcon name="arrow" /></button></article>
            </div>
          </section>

          <section id="demo-panel-queue" role="tabpanel" aria-labelledby="demo-tab-queue" tabindex="0" data-demo-panel="queue" hidden>
            <div class="demo-page-heading"><div><h3>Queue</h3><p>Match work to the printers that can make it.</p></div><span class="demo-sample-badge">2 sample jobs</span></div>
            <div class="demo-queue-summary"><span><i class="demo-dot demo-dot-blue"></i><span data-printing-count>1</span> in progress</span><span><i class="demo-dot demo-dot-amber"></i><span data-queued-count>1</span> queued</span></div>
            <div class="demo-queue-layout">
              <div class="demo-job-list">
                <article class="demo-job"><div class="demo-part-icon" aria-hidden="true"><span></span></div><div class="demo-job-copy"><h4>Enclosure base</h4><p>4 units · PLA Black · Workshop P1S</p><span class="demo-status" data-base-status data-status="attention">Awaiting clearance</span></div><button class="demo-button" type="button" data-demo-diagnose aria-expanded="false" aria-controls="demo-diagnosis" disabled><span data-diagnose-label>View diagnosis</span></button></article>
                <article class="demo-job"><div class="demo-part-icon demo-part-blue" aria-hidden="true"><span></span></div><div class="demo-job-copy"><h4>Enclosure lid</h4><p>4 units · PLA Blue · Studio A1</p><span class="demo-status" data-status="printing">Printing · 64%</span></div><span class="demo-job-note">Plate 1</span></article>
              </div>
              <aside class="demo-diagnosis" id="demo-diagnosis" aria-labelledby="demo-diagnosis-title" hidden><div class="demo-diagnosis-heading"><h4 id="demo-diagnosis-title">Job diagnosis</h4><button type="button" class="demo-close" data-demo-close-diagnosis aria-label="Close job diagnosis">×</button></div><p>Enclosure base → Workshop P1S</p><ul><li><DemoIcon name="check" /><span>Printer and nozzle match</span></li><li><DemoIcon name="check" /><span>PLA Black loaded</span></li><li data-readiness-check><span class="demo-check-symbol" data-readiness-symbol>!</span><span data-readiness-description>Bed clearance needed</span></li></ul><p class="demo-physical-note">In your farm, inspect the output and clear the bed before marking a printer ready.</p><button class="demo-button demo-button-primary" type="button" data-demo-ready disabled><span data-ready-label>Mark ready</span><DemoIcon name="arrow" /></button></aside>
            </div>
          </section>

          <section id="demo-panel-runs" role="tabpanel" aria-labelledby="demo-tab-runs" tabindex="0" data-demo-panel="runs" hidden>
            <div class="demo-page-heading"><div><h3>Runs</h3><p>Start with complete products. Plan the components.</p></div><span class="demo-sample-badge">Example plan</span></div>
            <div class="demo-run-layout"><div class="demo-run-planner"><div class="demo-assembly-art" aria-hidden="true"><div class="demo-assembly-lid"></div><div class="demo-assembly-base"></div></div><h4>Enclosure assembly</h4><p>One base + one lid per set</p><div class="demo-range-heading"><label for="demo-set-quantity">Sets to make</label><output for="demo-set-quantity" data-run-sets>8 sets</output></div><input id="demo-set-quantity" type="range" min="1" max="24" step="1" value="8" disabled /><div class="demo-range-labels" aria-hidden="true"><span>1 set</span><span>24 sets</span></div></div><div class="demo-run-plan"><p class="demo-section-label">Planned output</p><dl><div><dt>Enclosure bases</dt><dd data-run-units>8 units</dd></div><div><dt>Enclosure lids</dt><dd data-run-units>8 units</dd></div><div><dt>Total printed components</dt><dd data-run-components>16 units</dd></div></dl><div class="demo-plate-heading"><strong data-run-plates-label>4 whole plates</strong><span>Planned jobs</span></div><div class="demo-plate-strip" data-run-plates role="img" aria-label="4 planned plates">{Array.from({length:4}, () => <span></span>)}</div><p class="demo-physical-note">Example layout: four bases or four lids per plate. This plan uses whole plates.</p><a href="/docs/production/runs/" class="demo-guide-link">How production runs work <DemoIcon name="arrow" /></a></div></div>
          </section>

          <section id="demo-panel-filament" role="tabpanel" aria-labelledby="demo-tab-filament" tabindex="0" data-demo-panel="filament" hidden>
            <div class="demo-page-heading"><div><h3>Filament</h3><p>Know what is loaded and what is left.</p></div><span class="demo-sample-badge">3 tracked spools</span></div>
            <div class="demo-filament-layout"><div class="demo-spool-list" role="group" aria-label="Choose a sample spool">{spools.map((spool, index) => <button class="demo-spool-option" type="button" data-demo-spool={spool.id} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="demo-spool-detail" disabled><span class="demo-spool-mini" style={`--spool-color:${spool.color}`} aria-hidden="true"></span><span><strong>{spool.name}</strong><span>{spool.printer}</span></span><span class="demo-spool-weight">{spool.remaining} g</span></button>)}</div><div class="demo-spool-detail" id="demo-spool-detail"><div class="demo-spool-large" data-spool-art style="--spool-color:#27272a" aria-hidden="true"></div><h4 data-spool-name>PLA · Black</h4><p data-spool-location>P1S · AMS slot 1</p><dl><div><dt>Remaining</dt><dd data-spool-weight>740 g</dd></div><div><dt>Original spool</dt><dd>1,000 g</dd></div></dl><div class="demo-stock-meter" role="meter" aria-label="Sample filament remaining" aria-valuenow="740" aria-valuemin="0" aria-valuemax="1000" data-spool-meter><span style="width:74%" data-spool-meter-fill></span></div><p class="demo-physical-note">Tracked inventory stays linked to the loaded feed slot.</p></div></div>
          </section>
          <div class="demo-hint"><span class="demo-hint-dot" aria-hidden="true"></span><p data-demo-hint>Try marking the P1S ready, or open Queue to see why its next job is waiting.</p></div>
        </div>
      </div>
      <p class="demo-announcement" role="status" aria-live="polite" aria-atomic="true" data-demo-announcement></p>
      <noscript><p class="demo-noscript">Enable JavaScript to explore the interactive sample, or <a href="/docs/">read the guides</a>.</p></noscript>
    </div>
  </div>
  <div class="demo-tour" aria-label="Things to try in the preview">{views.map((view, index) => <button type="button" data-tour-view={view.id} aria-pressed={index === 0 ? 'true' : 'false'} disabled><span>0{index+1}</span><strong>{view.caption}</strong><DemoIcon name="arrow" /></button>)}</div>
  <p class="demo-caption">A simplified, interactive sample of OpenFarm workflows. Your changes stay in this preview.</p>
</section>

<script>
  import { mountProductDemo } from '../scripts/product-demo';
  const root = document.querySelector<HTMLElement>('[data-product-demo]');
  if (root) mountProductDemo(root);
</script>
